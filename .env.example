# Copy this file to `.env` and fill in your token.
# Get a token at https://discord.com/developers/applications -> your app -> Bot.

# Required
DISCORD_TOKEN=your-bot-token-here

# Optional
# Discord server id — commands appear instantly in this server while developing.
# Leave empty to publish commands globally (may take up to 1 hour).
DISCORD_GUILD_ID=

# Default Egyptian city key (see salahbot/cities.py) e.g. cairo, alexandria, giza
DEFAULT_CITY=cairo

# DEBUG / INFO / WARNING
LOG_LEVEL=INFO
